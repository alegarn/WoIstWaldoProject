{
  "cli": {
    "version": ">= 5.6.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_BACKEND_URL": "https://winning-bear-up.ngrok-free.app/"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_APP_BACKEND_URL": "https://woistwaldo-api.onrender.com/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
